PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
DB_POOL_MAX=10
FIELD_ENCRYPTION_KEY=GENERATE_A_BASE64_32_BYTE_KEY

# Storage upload credentials are server-only; use the new secret key from Supabase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Copy the connection URI from Supabase Dashboard > Project Settings > Database.
# Copy a Session pooler URI (port 5432) if your backend host cannot use IPv6 direct access.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
